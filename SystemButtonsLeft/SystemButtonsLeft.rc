#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(936)

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 260, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "win按钮居左，软件图标居中"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "系统按钮（开始/搜索/多任务视图）固定在左侧",IDC_SPLIT_ENABLE_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,246,10
    GROUPBOX        "当前状态",IDC_STATIC,7,20,246,86
    LTEXT           "",IDC_STATUS_LINE1,14,30,232,8
    LTEXT           "",IDC_STATUS_LINE2,14,39,232,8
    LTEXT           "",IDC_STATUS_LINE3,14,48,232,8
    LTEXT           "",IDC_STATUS_LINE4,14,57,232,8
    LTEXT           "",IDC_STATUS_LINE5,14,66,232,8
    LTEXT           "",IDC_STATUS_LINE6,14,75,232,8
    LTEXT           "",IDC_STATUS_LINE7,14,84,232,8
    LTEXT           "",IDC_STATUS_LINE8,14,93,232,8
    LTEXT           "取消勾选并点“确定”，即可恢复Windows默认布局。",IDC_SPLIT_HINT_STATIC,7,111,246,8
    DEFPUSHBUTTON   "确定",IDOK,149,123,50,14
    PUSHBUTTON      "取消",IDCANCEL,203,123,50,14
END


